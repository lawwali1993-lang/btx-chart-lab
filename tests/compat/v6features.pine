//@version=6
indicator("v6 features", overlay = true, max_polylines_count = 10)
enum Mode
    fast = "Fast"
    slow = "Slow"
mode = input.enum(Mode.fast, "Mode")
len = switch mode
    Mode.fast => 10
    Mode.slow => 30
var points = array.new<chart.point>()
if ta.change(time("60")) != 0
    points.push(chart.point.from_time(time, close))
    if points.size() > 20
        points.shift()
var polyline pl = na
if barstate.islast
    polyline.delete(pl)
    pl := polyline.new(points, curved = true, line_color = color.yellow, line_width = 2)
f() =>
    s = 0
    for i = 0 to 20
        if i % 2 == 0
            continue
        if i > 15
            break
        s += i
    s
m = matrix.new<float>(2, 2, 1.0)
m.set(0, 1, 3.0)
d = m.det()
mp = map.new<string, int>()
mp.put("a", 1)
cnt = 0
while cnt < 3
    cnt += 1
plot(ta.ema(close, len), "EMA mode", color.aqua)
plot(f() + d * 0 + mp.get("a") * 0 + cnt * 0, "loop", display = display.data_window)
lbl = str.format_time(time, "yyyy-MM-dd HH:mm", "UTC") + " " + str.tostring(mode)
if barstate.islast
    label.new(bar_index, high, lbl, style = label.style_label_down, color = color.blue, textcolor = color.white)
